# scripts/run_evaluation.py

"""
This script automates the evaluation of the Copilot against a benchmark dataset.
It reads benchmark.json, queries the live Copilot API, executes POST requests 
to the Ragas evaluator, and writes an evaluation_report.json.
"""

import json
import httpx
import os

project_root = os.path.dirname(os.path.dirname(__file__))

# API Endpoints
COPILOT_URL = "http://localhost:8002/api/v1/chat"
EVAL_URL = "http://localhost:8001/evaluate"

# File Paths
BENCHMARK_FILE = os.path.join(project_root, "tests", "evaluation", "benchmark.json")
REPORT_FILE = "evaluation_report.json"

def generate_copilot_answer(client: httpx.Client, question: str):
    """
    Invokes the actual CodegraphCopilot API to retrieve the real answer and contexts.
    """
    payload = {"prompt": question}
    
    try:
        response = client.post(COPILOT_URL, json=payload, timeout=60.0)
        response.raise_for_status()
        data = response.json()
        
        # DEBUG: Print the actual JSON keys returned by your backend
        print(f"  [DEBUG] API Response Keys: {list(data.keys())}")
        
        # Dynamically map common API response keys for the answer
        answer = (
            data.get("answer") or 
            data.get("response") or 
            data.get("result") or 
            data.get("reply") or 
            ""
        )
        
        # Dynamically map common API response keys for the contexts
        contexts = (
            data.get("contexts") or 
            data.get("context") or 
            data.get("documents") or 
            data.get("sources") or 
            data.get("source_documents") or 
            []
        )
        
        return {
            "answer": answer,
            "contexts": contexts
        }
        
    except httpx.RequestError as e:
        print(f"Network error connecting to Copilot API: {e}")
        return {"answer": "", "contexts": []}
    except httpx.HTTPStatusError as e:
        print(f"Copilot API returned HTTP {e.response.status_code}: {e.response.text}")
        return {"answer": "", "contexts": []}

def run_batch_evaluation():
    if not os.path.exists(BENCHMARK_FILE):
        print(f"Error: {BENCHMARK_FILE} not found.")
        return

    with open(BENCHMARK_FILE, "r") as f:
        benchmark_data = json.load(f)

    evaluation_results = []
    print(f"Starting evaluation for {len(benchmark_data)} test cases...\n")

    # Use a single HTTPX client session for connection pooling
    with httpx.Client(timeout=60.0) as client:
        for item in benchmark_data:
            question = item["question"]
            expected_answer = item["expected_answer"]
            category = item.get("category", "General")
            
            print(f"Evaluating [{category}]: {question}")

            # Step A: Get the REAL generated answer and context from Copilot
            copilot_data = generate_copilot_answer(client, question)
            
            # Fail-safe: Skip evaluation if Copilot failed to return valid data
            if not copilot_data["answer"] or not copilot_data["contexts"]:
                print(f"Skipping Evaluator: Copilot returned empty data for '{question}'.\n")
                continue
            
            # Step B: Construct the payload for the RAG Evaluator
            payload = {
                "developer_query": question,
                "codegraph_contexts": copilot_data["contexts"],
                "copilot_answer": copilot_data["answer"],
                "ground_truth": expected_answer
            }

            # Step C: Send the payload to the local RAG Evaluator service
            try:
                response = client.post(EVAL_URL, json=payload, timeout=120.0)
                response.raise_for_status()
                
                eval_scores = response.json()
                print(f"Result: {eval_scores}\n")
                
                evaluation_results.append({
                    "question": question,
                    "expected_answer": expected_answer,
                    "copilot_answer": copilot_data["answer"],
                    "eval_scores": eval_scores
                })

            except httpx.RequestError as e:
                print(f"Network error connecting to Evaluator for '{question}': {e}\n")
            except httpx.HTTPStatusError as e:
                print(f"Evaluator returned HTTP {e.response.status_code}: {e.response.text}\n")

    # Save the comprehensive evaluation report
    with open(REPORT_FILE, "w") as f:
        json.dump(evaluation_results, f, indent=4)
    
    print(f"Batch evaluation complete. Report saved to {REPORT_FILE}")

if __name__ == "__main__":
    run_batch_evaluation()
```

