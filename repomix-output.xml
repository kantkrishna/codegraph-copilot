        button { padding: 0.75rem 1.5rem; background: #002b36; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; font-weight: bold; }
        button:disabled { background: #999; cursor: not-allowed; }
        
        .loading { font-style: italic; color: #666; background: transparent; border: none; box-shadow: none; }
        
        /* US-4.3 Evidence and Confidence Distinction Styling */
        .evidence-wrapper { background-color: #f1f8ff; border-left: 4px solid #007bff; padding: 0.1rem 1rem; margin-top: 1.5rem; border-radius: 0 4px 4px 0; }
        .confidence-wrapper { background-color: #fff8f1; border-left: 4px solid #f0ad4e; padding: 0.1rem 1rem; margin-top: 1rem; border-radius: 0 4px 4px 0; }
    </style>
</head>
<body>
    <header>
        <h1>CodeGraph Engineering Copilot</h1>
    </header>
    
    <div id="chat-container">
        <div class="message bot-msg">Hello! I am the CodeGraph Engineering Copilot. Ask me about the system architecture, dependencies, or codebase flows.</div>
    </div>
    
    <div class="input-container">
        <form id="chat-form">
            <input type="text" id="prompt" placeholder="e.g., What components depend on PaymentService?" required autocomplete="off" />
            <button type="submit" id="send-btn">Send</button>
        </form>
    </div>

    <script>
        const chatContainer = document.getElementById('chat-container');
        const chatForm = document.getElementById('chat-form');
        const promptInput = document.getElementById('prompt');
        const sendBtn = document.getElementById('send-btn');

        /**
         * US-4.3: Processes raw Markdown to wrap the Evidence and Confidence sections 
         * in styled HTML blocks before passing it to marked.js.
         */
        function formatGroundedResponse(markdown) {
            let html = marked.parse(markdown);
            
            // Encapsulate Evidence
            html = html.replace(/<h3[^>]*>Evidence<\/h3>/g, '<div class="evidence-wrapper"><h3>Evidence</h3>');
            // Encapsulate Confidence and close Evidence
            html = html.replace(/<h3[^>]*>Confidence<\/h3>/g, '</div><div class="confidence-wrapper"><h3>Confidence</h3>');
            
            // Close the final div if Confidence block was appended
            if (html.includes('confidence-wrapper')) {
                html += '</div>';
            } else if (html.includes('evidence-wrapper')) {
                html += '</div>'; // Close evidence if no confidence existed
            }
            
            return html;
        }

        function addMessage(text, className, id = null, isHtml = false) {
            const el = document.createElement('div');
            el.className = 'message ' + className;
            if (id) el.id = id;
            
            if (isHtml) {
                el.innerHTML = text;
            } else {
                el.textContent = text;
            }
            
            chatContainer.appendChild(el);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const prompt = promptInput.value.trim();
            if (!prompt) return;

            addMessage(prompt, 'user-msg');
            promptInput.value = '';
            sendBtn.disabled = true;

            const loadingId = 'loading-' + Date.now();
            addMessage('Thinking...', 'bot-msg loading', loadingId);

            try {
                const response = await fetch('/api/v1/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt })
                });
                
                const data = await response.json();
                document.getElementById(loadingId).remove();
                
                if (response.ok) {
                    addMessage(formatGroundedResponse(data.response), 'bot-msg', null, true);
                } else {
                    addMessage('Error: ' + (data.detail || 'Failed to fetch response.'), 'bot-msg');
                }
            } catch (error) {
                document.getElementById(loadingId).remove();
                addMessage('Network Error: Could not connect to the Copilot API.', 'bot-msg');
            } finally {
                sendBtn.disabled = false;
                promptInput.focus();
            }
        });
    </script>
</body>
</html>
