# scripts/rag_evaluator.py
"""
RAGAS Evaluation Service
This script provides a FastAPI endpoint to evaluate the quality of code generation answers using the RAGAS framework.
It accepts a POST request with the following JSON payload:
{
    "developer_query": "string",
    "codegraph_contexts": ["string"],
    "copilot_answer": "string",
    "ground_truth": "string"
}
It returns a JSON response with the evaluation results:
{
    "faithfulness": 0.0,
    "answer_relevance": 0.0,
    "context_precision": 0.0
}
"""
# scripts/rag_evaluator.py
import os
import sys
from unittest.mock import MagicMock
# --- EMERGENCY PATCH FOR RAGAS VERTEXAI BUG ---
sys.modules['langchain_community.chat_models.vertexai'] = MagicMock()
sys.modules['langchain_community.chat_models.vertexai'].ChatVertexAI = MagicMock
# ----------------------------------------------
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from typing import List
from datasets import Dataset
# LangChain and RAGAS Wrappers for Dependency Injection
from langchain_openai import ChatOpenAI, OpenAIEmbeddings
from ragas.llms import LangchainLLMWrapper
from ragas.embeddings import LangchainEmbeddingsWrapper
from ragas import evaluate
from ragas.metrics import faithfulness, answer_relevancy, context_precision
# Import your application settings
from backend.config import settings
app = FastAPI(title="RAGAS Evaluation Service")
class EvaluationRequest(BaseModel):
    developer_query: str
    codegraph_contexts: List[str]
    copilot_answer: str
    ground_truth: str
@app.post("/evaluate")
async def run_ragas_evaluation(request: EvaluationRequest):
    # 1. Retrieve the API key from Pydantic settings safely
    raw_key = getattr(settings, "llm_api_key", None)
    if not raw_key:
        raise HTTPException(
            status_code=500, 
            detail="LLM_API_KEY is not set in settings or environment."
        )
    # Safely extract the string value whether Pydantic wraps it in SecretStr or not
    key_val = raw_key.get_secret_value() if hasattr(raw_key, "get_secret_value") else str(raw_key)
    # 2. Retrieve the LLM model name from config (fallback to gpt-4o-mini if undefined)
    llm_model_name = getattr(settings, "llm_model", "gpt-4o-mini")
    data = {
        "question": [request.developer_query],
        "contexts": [request.codegraph_contexts], 
        "answer": [request.copilot_answer],
        "ground_truth": [request.ground_truth]
    }
    try:
        # 3. Explicitly instantiate LangChain models with your configuration
        custom_llm = ChatOpenAI(model=llm_model_name, api_key=key_val, temperature=0)
        # Ragas also requires an embedding model to calculate context precision
        custom_embeddings = OpenAIEmbeddings(model="text-embedding-3-small", api_key=key_val)
        # 4. Wrap them in RAGAS framework wrappers
        ragas_llm = LangchainLLMWrapper(custom_llm)
        ragas_emb = LangchainEmbeddingsWrapper(custom_embeddings)
        dataset = Dataset.from_dict(data)
        # 5. Execute RAGAS pipeline using explicit Dependency Injection
        evaluation_result = evaluate(
            dataset,
            metrics=[faithfulness, answer_relevancy, context_precision],
            llm=ragas_llm,
            embeddings=ragas_emb
        )
        df = evaluation_result.to_pandas()
        scores = {
            "faithfulness": float(df["faithfulness"].fillna(0).iloc[0]),
            "answer_relevance": float(df["answer_relevancy"].fillna(0).iloc[0]),
            "context_precision": float(df["context_precision"].fillna(0).iloc[0]),
        }
        return scores
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"RAGAS Evaluation Error: {str(e)}")
if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8001)
